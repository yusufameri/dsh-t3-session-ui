{
  "name": "dsh-t3-session-ui",
  "version": "0.1.0",
  "description": "T3 Code's session-context UX for DeepSeek Harness: a session-row context block, provider chip, status pill, header context strip, and a context-window meter with compaction.",
  "type": "module",
  "license": "MIT",
  "author": "yusufameri",
  "homepage": "https://github.com/yusufameri/dsh-t3-session-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufameri/dsh-t3-session-ui.git"
  },
  "bugs": {
    "url": "https://github.com/yusufameri/dsh-t3-session-ui/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis-plugin",
    "session-context",
    "context-window",
    "t3code"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/host.test.js test/client.test.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
